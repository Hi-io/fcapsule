# Optional DeepSeek-compatible AI briefing and offline evaluation.
# Keep real keys out of committed files.
FCAPSULE_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optional manual image/audio evidence via OpenRouter.
OPENROUTER_API_KEY=

# Optional shared Estima memory. FCAPSule sends a service token only; model calls stay local.
FCAPSULE_ESTIMA_URL=
FCAPSULE_ESTIMA_TOKEN=
FCAPSULE_ESTIMA_INSTANCE_ID=
FCAPSULE_ESTIMA_READ=false
FCAPSULE_ESTIMA_PUBLISH=false
# Legacy FCAPSULE_ATLAS_* variables remain supported during migration.
